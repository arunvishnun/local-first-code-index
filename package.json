{
  "name": "local-first-code-index",
  "version": "0.1.0",
  "description": "Local-first repository indexing and deterministic retrieval for desktop AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node ./scripts-clean.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm pack --dry-run",
    "benchmark:graph": "npm run build && node benchmark/graph-update.mjs",
    "benchmark:retrieval": "npm run build && node benchmark/retrieval-compare.mjs"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@xberg-io/tree-sitter-language-pack": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4"
  },
  "keywords": [
    "code-index",
    "desktop-agent",
    "sqlite",
    "fts5",
    "typescript",
    "retrieval",
    "tree-sitter"
  ],
  "license": "UNLICENSED"
}
